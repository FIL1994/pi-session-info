---
const rows = [
  { pid: '4101', directory: '/example/projects/composer' },
  { pid: '4102', directory: '/example/projects/review-app' },
];
---

<section aria-label="Illustrative process inventory" class="inventory-preview not-content my-8 overflow-hidden rounded-2xl border border-slate-700 bg-slate-950 text-slate-200 shadow-xl">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800 bg-slate-900 px-5 py-4">
    <div class="flex items-center gap-3">
      <span aria-hidden="true" class="flex gap-1.5">
        <span class="size-2 rounded-full bg-slate-600"></span>
        <span class="size-2 rounded-full bg-slate-600"></span>
        <span class="size-2 rounded-full bg-teal-400"></span>
      </span>
      <span class="font-mono text-xs text-slate-300">process inventory</span>
    </div>
    <span class="rounded-full border border-teal-800 bg-teal-950 px-2.5 py-1 font-mono text-xs text-teal-200">illustrative · not live</span>
  </div>
  <div class="p-5 sm:p-7">
    <p class="m-0 font-mono text-sm"><span aria-hidden="true" class="mr-3 text-teal-400">$</span>bun run start</p>
    <div class="mt-6 overflow-x-auto" tabindex="0" role="region" aria-label="Example process rows, scroll horizontally on narrow screens">
      <table class="w-full border-collapse whitespace-nowrap text-left font-mono text-xs sm:text-sm">
        <thead class="text-xs uppercase tracking-wider text-slate-400">
          <tr><th scope="col" class="pb-3 pr-6 font-normal">PID</th><th scope="col" class="pb-3 pr-6 font-normal">Activity</th><th scope="col" class="pb-3 font-normal">Directory</th></tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-t border-slate-800">
              <td class="py-4 pr-6 text-slate-300">{row.pid}</td>
              <td class="py-4 pr-6"><span class="rounded-md bg-slate-800 px-2 py-1 text-amber-200">unknown</span></td>
              <td class="py-4 text-slate-300">{row.directory}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mb-0 mt-5 border-t border-slate-800 pt-4 text-xs leading-6 text-slate-400">Fictional PIDs and paths. Simplified columns. Real discovery reports process presence—not conversation activity.</p>
  </div>
</section>
